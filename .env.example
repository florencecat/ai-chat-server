# Server
PORT=8091

# LLM-провайдер: yandex | gigachat.
# Сервер развивается под Yandex; провайдер gigachat оставлен рабочим, но без
# строгой схемы ответа — формат там держится только на промте.
LLM_PROVIDER=yandex

# ── GigaChat (нужно при LLM_PROVIDER=gigachat) ────────────────────────────────
# Задайте ЛИБО GIGACHAT_AUTH_KEY (готовая Base64-строка «Авторизационные данные»
# из личного кабинета), ЛИБО пару client id/secret.
GIGACHAT_AUTH_KEY=your-base64-authorization-key
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_SKIP_TLS=true

# ── Yandex AI Studio (нужно при LLM_PROVIDER=yandex) ──────────────────────────
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_MODEL=yandexgpt-lite/latest
YANDEX_TEMPERATURE=0.25
# Потолок длины ответа. Со строгой схемой модель обязана выдать все поля
# разом, поэтому запаса нужно больше, чем на один текст: на 700 токенах JSON
# обрывался на полуслове. Длину ответа держит не этот потолок, а инструкция
# «5–7 абзацев» в промте — это аварийный предохранитель.
YANDEX_MAX_TOKENS=1500
# Строгая схема ответа (response_format.json_schema). Поддерживают не все
# модели каталога: если модель ответит 400, сервер один раз повторит запрос
# без схемы и напишет об этом в лог.
YANDEX_STRUCTURED_OUTPUT=true

# ── Промты ───────────────────────────────────────────────────────────────────
# Системную инструкцию собирает сервер. Приоритет: SYSTEM_PROMPT_FILE,
# затем SYSTEM_PROMPT, затем встроенный дефолт.
SYSTEM_PROMPT_FILE=prompts/system.txt
# Промт для POST /v2/chat. По умолчанию prompts/system_v2.txt; если файла нет,
# v2 работает на промте v1.
SYSTEM_PROMPT_V2_FILE=prompts/system_v2.txt

# Блоки, подставляемые в промт вместо {{FORMAT}}.
FORMAT_MARKUP_FILE=prompts/format_markup.txt
FORMAT_PLAIN_FILE=prompts/format_plain.txt

# Разметка ответа в старом POST /chat. false — модель отвечает обычным
# текстом: установленные сборки без markdown-рендера показали бы звёздочки
# текстом. В /v2/chat разметка включена всегда.
MARKUP_ENABLED=false

# Версия промта. Входит в ключ кэша и в поле prompt_version ответа — без неё
# после правки промта пользователи ещё CACHE_TTL получают старые ответы.
# Меняйте вместе с любой правкой файлов промтов.
PROMPT_VERSION=p3

# Маркеры, при которых сервер поднимает urgency до vet_24h. Понижать уровень
# автоматически сервер не умеет и не должен.
RED_FLAGS_FILE=prompts/red-flags.yaml

# Лимит длины применяется к каждому сообщению по отдельности; история
# ограничивается числом сообщений и суммарной длиной.
MAX_MESSAGE_LEN=4000
MAX_HISTORY_MESSAGES=10
MAX_HISTORY_CHARS=8000

# Cache
CACHE_TTL=1h

# Quota (применяется к записям коллекции tokens в PocketBase)
# QUOTA_PER_MINUTE / QUOTA_PER_DAY — лимиты бесплатного тарифа.
QUOTA_PER_MINUTE=1
QUOTA_PER_DAY=15
QUOTA_PER_MINUTE_PREMIUM=5
QUOTA_PER_DAY_PREMIUM=200

# Модели по тарифам. Пусто — модель провайдера по умолчанию
# (GIGACHAT_MODEL / YANDEX_MODEL).
MODEL_FREE=
MODEL_PREMIUM=

# Сколько премиум ещё действует после expiry — страховка от опоздавшего
# вебхука о продлении.
ENTITLEMENT_GRACE=24h

# Storage (BoltDB — используется только для кэша)
DB_PATH=data/ai-server.db

# PocketBase
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=your-superuser-password

# ── RuStore Public API (верификация покупок Pay SDK) ──────────────────────────
# Выключено по умолчанию: без этого блока сервер работает, но все пользователи
# остаются на бесплатном тарифе, а POST /verify отвечает 503.
RUSTORE_ENABLED=false
RUSTORE_API_URL=https://public-api.rustore.ru

# Ключ сервисного доступа из консоли RuStore (Настройки → Ключи доступа).
RUSTORE_KEY_ID=
# Приватный RSA-ключ: файл предпочтительнее, PEM плохо живёт в одной строке.
RUSTORE_PRIVATE_KEY_FILE=secrets/rustore-private-key.pem
# Альтернатива файлу: PEM или base64(PEM) одной строкой.
RUSTORE_PRIVATE_KEY=

# Package name приложения и его ID из консоли (ID нужен только для
# подтверждения разовых покупок).
RUSTORE_PACKAGE_NAME=ru.pet.sputnik
RUSTORE_APP_ID=

# Коды подписок через запятую. Клиент присылает только purchaseId, а
# Subscription Data v4 требует ещё и код продукта — сервер перебирает этот список.
RUSTORE_SUBSCRIPTION_IDS=premium_month,premium_year

# Песочница: true — работаем с /public/sandbox/ и принимаем только
# уведомления с суффиксом _SANDBOX.
RUSTORE_SANDBOX=false

# Ключ расшифровки серверных уведомлений (консоль → Монетизация →
# Серверные уведомления). Пусто — вебхук отвечает 503.
RUSTORE_NOTIFICATION_KEY=
RUSTORE_WEBHOOK_PATH=/rustore/webhook
