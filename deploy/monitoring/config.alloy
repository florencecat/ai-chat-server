// Alloy собирает логи контейнеров и access-лог Caddy и отправляет их в Loki.

// ── Docker ────────────────────────────────────────────────────────────────
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.containers.receiver]
}

// ai-server пишет JSON (slog): level поднимаем в метку, чтобы фильтровать
// ошибки без разбора каждой строки. Остальные поля разбираются в запросе
// через `| json`.
loki.process "containers" {
  stage.match {
    selector = "{service=\"ai-server\"}"

    stage.json {
      expressions = { level = "level" }
    }

    stage.labels {
      values = { level = "" }
    }
  }

  forward_to = [loki.write.default.receiver]
}

// ── Caddy ─────────────────────────────────────────────────────────────────
local.file_match "caddy" {
  path_targets = [{
    "__path__" = "/var/log/caddy/access.log",
    "job"      = "caddy",
  }]
}

loki.source.file "caddy" {
  targets    = local.file_match.caddy.targets
  forward_to = [loki.write.default.receiver]
}

// ── Loki ──────────────────────────────────────────────────────────────────
loki.write "default" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}
